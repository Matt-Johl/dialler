# baresip config for the headless harness phone. @MODULE_PATH@ and
# @TRANSPORT@ are filled in by entrypoint.sh. TLS verification is off
# because the server uses a self-signed dev certificate.
#
# TRANSPORT=tls (default): an app-leg phone registered to the light server.
# TRANSPORT=udp: a "desk phone" registered to the harness PBX (Asterisk).

poll_method             epoll

# SIP
sip_listen              0.0.0.0:0
sip_verify_server       no
sip_transports          @TRANSPORT@

# Audio: WAV in, WAV out (SPEC §7.1 automated audio sibling)
audio_player            aufile,/media/out-@SIP_USER@.wav
audio_source            @AUDIO_SOURCE@
audio_alert             none
audio_srate             48000
audio_channels          1

# Media
rtp_tos                 184
jitter_buffer_type      adaptive

# Modules
module_path             @MODULE_PATH@
module                  opus.so
module                  g711.so
module                  aufile.so
module                  ice.so
# The WAV files are 48 kHz stereo; G.711 legs (the PBX trunk) run 8 kHz
# mono, so the audio filters must convert, as they do in the app.
module                  auconv.so
module                  auresamp.so

# Application modules
module_app              account.so
module_app              contact.so
module_app              menu.so
module_app              ctrl_tcp.so

ctrl_tcp_listen         0.0.0.0:4444
